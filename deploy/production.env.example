SOUNDTRACE_DOMAIN=soundtrace.your-domain.com
SOUNDTRACE_USER_QUOTA_MB=1024
# Web JS API key (public, restricted by domain); security code stays server-side.
SOUNDTRACE_AMAP_KEY=
SOUNDTRACE_AMAP_SECURITY_CODE=
SOUNDTRACE_AMAP_STYLE=amap://styles/normal
# Default: domestic Mureka instrumental API. One piece per request.
SOUNDTRACE_MUSIC_PROVIDER=mureka
SOUNDTRACE_MUREKA_KEY=
SOUNDTRACE_MUREKA_MODEL=mureka-9.5
SOUNDTRACE_MUSIC_DAILY_LIMIT=5
# Alternative: private ACE-Step 1.5 XL service (set provider=acestep).
SOUNDTRACE_ACE_URL=
SOUNDTRACE_ACE_KEY=
SOUNDTRACE_ACE_MODEL=acestep-v15-xl-sft
SOUNDTRACE_ACE_LM=acestep-5Hz-lm-4B
# Domestic Seedream photo stylization. Secret stays exclusively on the server.
SOUNDTRACE_ARK_KEY=
SOUNDTRACE_IMAGE_MODEL=doubao-seedream-5-0-pro-260628
SOUNDTRACE_IMAGE_DAILY_LIMIT=5
