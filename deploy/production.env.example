SOUNDTRACE_DOMAIN=soundtrace.your-domain.com
SOUNDTRACE_USER_QUOTA_MB=1024
# Tencent JSAPI GL key; optional separate WebService key for GPS conversion.
# Keys stay on the server; style is optional (publish it in the Tencent console).
SOUNDTRACE_TENCENT_MAP_KEY=
SOUNDTRACE_TENCENT_MAP_SERVICE_KEY=
SOUNDTRACE_TENCENT_MAP_STYLE=
# Default: domestic Mureka instrumental API. One piece per request.
SOUNDTRACE_MUSIC_PROVIDER=mureka
SOUNDTRACE_MUREKA_KEY=
SOUNDTRACE_MUREKA_MODEL=mureka-9.5
SOUNDTRACE_MUSIC_DAILY_LIMIT=5
# Alternative: private ACE-Step 1.5 service (set provider=acestep).
SOUNDTRACE_ACE_URL=
SOUNDTRACE_ACE_KEY=
SOUNDTRACE_ACE_MODEL=acestep-v15-turbo
SOUNDTRACE_ACE_LM=acestep-5Hz-lm-0.6B
# Domestic Seedream photo stylization. Secret stays exclusively on the server.
SOUNDTRACE_ARK_KEY=
SOUNDTRACE_IMAGE_MODEL=doubao-seedream-5-0-pro-260628
SOUNDTRACE_IMAGE_DAILY_LIMIT=5

# Turbo profile: no additional language model is required.
SOUNDTRACE_ACE_THINKING=false
SOUNDTRACE_ACE_STEPS=8

# Private AudioSep/CLAP service (soundtrace_gpu.py), reachable only by the backend.
SOUNDTRACE_GPU_URL=
SOUNDTRACE_GPU_USER=soundtrace
SOUNDTRACE_GPU_PASSWORD=
SOUNDTRACE_SOUND_DAILY_LIMIT=10
